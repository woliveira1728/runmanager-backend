generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ORGANIZER
  ATHLETE
}

enum Gender {
  M
  F
  OUTRO
}

enum ShirtSize {
  PP
  P
  M
  G
  GG
}

enum EventStatus {
  DRAFT
  PUBLISHED
  FINISHED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  email         String          @unique
  passwordHash  String          @map("password_hash")
  role          Role            @default(ATHLETE)
  createdAt     DateTime        @default(now()) @map("created_at")

  athleteProfile AthleteProfile?
  organizedEvents Event[]       @relation("OrganizerEvents")
  registrations  Registration[]

  @@map("users")
}

model AthleteProfile {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @unique @map("user_id") @db.Uuid
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cpf              String       @unique
  birthDate        DateTime     @map("birth_date") @db.Date
  gender           Gender
  shirtSize        ShirtSize    @map("shirt_size")
  emergencyContact String       @map("emergency_contact") // Criptografado em repouso
  medicalNotes     String?      @map("medical_notes")     // Criptografado em repouso
  lgpdConsent      Boolean      @default(false) @map("lgpd_consent")
  lgpdConsentAt    DateTime?    @map("lgpd_consent_at")

  @@map("athlete_profiles")
}

model Event {
  id          String       @id @default(uuid()) @db.Uuid
  organizerId String       @map("organizer_id") @db.Uuid
  organizer   User         @relation("OrganizerEvents", fields: [organizerId], references: [id])
  title       String
  description String       @db.Text
  eventDate   DateTime     @map("event_date")
  location    String
  status      EventStatus  @default(DRAFT)
  createdAt   DateTime     @default(now()) @map("created_at")

  modalities    Modality[]
  registrations Registration[]

  @@map("events")
}

model Modality {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String   // ex: 5km, 10km, 21km
  minAge    Int      @default(0) @map("min_age")

  registrationBatches RegistrationBatch[]

  @@map("modalities")
}

model RegistrationBatch {
  id          String   @id @default(uuid()) @db.Uuid
  modalityId  String   @map("modality_id") @db.Uuid
  modality    Modality @relation(fields: [modalityId], references: [id], onDelete: Cascade)
  batchNumber Int      @map("batch_number")
  price       Decimal  @db.Decimal(10, 2)
  maxSlots    Int      @map("max_slots")
  filledSlots Int      @default(0) @map("filled_slots")
  endDate     DateTime @map("end_date")

  registrations Registration[]

  @@map("registration_batches")
}

model Registration {
  id            String            @id @default(uuid()) @db.Uuid
  athleteId     String            @map("athlete_id") @db.Uuid
  athlete       User              @relation(fields: [athleteId], references: [id])
  batchId       String            @map("batch_id") @db.Uuid
  batch         RegistrationBatch @relation(fields: [batchId], references: [id])
  eventId       String            @map("event_id") @db.Uuid
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bibNumber     Int?              @map("bib_number")
  paymentStatus PaymentStatus     @default(PENDING) @map("payment_status")
  qrCodeHash    String            @unique @map("qr_code_hash")
  checkedIn     Boolean           @default(false) @map("checked_in")
  checkedInAt   DateTime?         @map("checked_in_at")
  createdAt     DateTime          @default(now()) @map("created_at")

  result        Result?

  @@unique([eventId, athleteId])
  @@map("registrations")
}

model Result {
  id             String       @id @default(uuid()) @db.Uuid
  registrationId String       @unique @map("registration_id") @db.Uuid
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  grossTime      String       @map("gross_time") // Tempo bruto HH:mm:ss
  netTime        String       @map("net_time")   // Tempo líquido HH:mm:ss
  overallPos     Int          @map("overall_pos")
  categoryPos    Int          @map("category_pos")
  importedAt     DateTime     @default(now()) @map("imported_at")

  @@map("results")
}
