{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "extensionsToTreatAsEsm": [".ts"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": {
          "module": "esnext",
          "target": "ES2022"
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!@nestjs)"
  ],
  "testEnvironment": "node"
}
