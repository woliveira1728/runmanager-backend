# Configuração do Servidor HTTP
PORT=3001
NODE_ENV=development

# Origens permitidas por CORS (separadas por vírgula em produção, ex: https://runmanager.vercel.app)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# String de conexão do PostgreSQL (Substitua pelos dados locais ou da nuvem Neon/Supabase/Render)
DATABASE_URL=postgresql://usuario_exemplo:senha_exemplo@localhost:5432/runmanager_db?schema=public

# Autenticação JWT (Defina um segredo próprio em produção)
JWT_SECRET=substitua_por_sua_chave_secreta_jwt_aqui
JWT_EXPIRES_IN=7d

# Criptografia LGPD em Repouso (Chave de 32 caracteres para AES-256-GCM)
ENCRYPTION_KEY=substitua_chave_32_bytes_aes256!
